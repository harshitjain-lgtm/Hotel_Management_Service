# Copy to .env and adjust. Never commit the real .env.
ENV=dev
# Demo mode enables demo-only knobs such as the X-Demo-Clock header (simulated staff local time).
DEMO_MODE=true

DATABASE_URL=postgresql+psycopg://staydesk:staydesk@127.0.0.1:5433/staydesk

# Generate real secrets for any shared/deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=480
# Fernet key for encrypting passport numbers at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = derived from JWT_SECRET (dev only).
PII_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173
TRUST_FORWARDED_FOR=true

# ---- Security events -> STAYSEC (HMS integration contract v1.0) ----
# v1 = STAYSEC contract envelope (default); internal = raw StayDesk audit events
EVENT_FORMAT=v1
# Comma-separated: sqs, file, http, stdout. Production: sqs (optionally file for local replay)
EVENT_SINKS=file
EVENT_FILE=data/events.jsonl
# SQS queue staysec-hms-events (URL + region shared privately by STAYSEC). Credentials come from the
# standard AWS chain (instance/task role, AWS_PROFILE, env vars); the role needs sqs:SendMessage on the queue.
SQS_QUEUE_URL=
AWS_REGION=ap-south-1
HEARTBEAT_SECONDS=30
PRODUCER_INSTANCE=
# Legacy HTTP sink (not part of the v1 contract)
INGEST_URL=
INGEST_API_KEY=
INGEST_HMAC_SECRET=
SHIPPER_INTERVAL_SECONDS=1.0
SHIPPER_BATCH_SIZE=200

# ---- STAYSEC shared secrets (shared privately; never commit real values) ----
# HMAC key for guest_ref = "h_" + HMAC_SHA256(GUEST_REF_KEY, guest_id)[:32]; identical on every instance
GUEST_REF_KEY=dev-guest-ref-key
# Verifies X-Staysec-Signature on POST /internal/security/actions
STAYSEC_SIGNING_SECRET=dev-staysec-signing-secret
STAYSEC_KEY_ID=staysec-1

# Key for the extended /context/* and /control/* APIs (demo tooling)
SERVICE_API_KEY=dev-service-key

ID_DOC_DIR=data/id_docs
